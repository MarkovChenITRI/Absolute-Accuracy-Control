{
  "id": "mr-j5",
  "version": "8",
  "title": "三菱 MR-J5 震動抑制調機程序（基底）",
  "note": "每一項驗收項目的步驟、判定與寫入，都寫在 sop 指向的標準作業流程那一節（「## 項次｜階段｜驗收項目」）；這裡只列階段、項次與往返關係。階段的順序與標準作業流程一致：慣量辨識 → 增益整定 ⇄ 共振抑制 → 制振控制 → 指令陷波。",
  "sop": "docs/標準作業流程.md",
  "params": [
    "負載慣量比",
    "速度控制增益",
    "速度積分補償",
    "位置控制增益",
    "模型控制增益",
    "過衝量補償",
    "陷波頻率1",
    "陷波形狀1",
    "陷波頻率2",
    "陷波形狀2",
    "陷波頻率5",
    "陷波形狀5",
    "陷波頻率3",
    "陷波形狀3",
    "陷波頻率4",
    "陷波形狀4",
    "抑制振動控制1振動頻率",
    "抑制振動控制1共振頻率",
    "抑制振動控制2振動頻率",
    "抑制振動控制2共振頻率",
    "指令陷波濾波器"
  ],
  "sources": {
    "ADJ": "docs/震動抑制調參/跨階段手冊/01_三菱_MR-J5_Adjustment_SH030306ENG-J.pdf（印刷頁碼 = PDF 頁碼 − 2）"
  },
  "pairs": [
    {
      "stages": ["gain", "resonance"],
      "direction": "共振抑制寫入濾波器後，增益整定（項次 3–6）改回未驗收，重新把增益往上試。",
      "source": "ADJ p.57 第 9 步"
    },
    {
      "stages": ["suppression", "notch"],
      "direction": "抑制振動控制處理不了的頻率交給指令陷波；指令陷波降 PB07 後，制振控制（項次 9、10）改回未驗收，重新調諧。",
      "source": "ADJ p.73、74、79"
    }
  ],
  "stages": [
    {
      "id": "inertia",
      "name": "慣量辨識",
      "scope": "axis",
      "criteria": [
        { "id": "inertia.pb06", "no": 1, "item": "負載慣量比 PB06 在監視模式下穩定" },
        { "id": "inertia.filter-reset", "no": 2, "item": "濾波器與抑制振動控制為初始狀態" }
      ]
    },
    {
      "id": "gain",
      "name": "增益整定",
      "scope": "axis",
      "pair": "resonance",
      "criteria": [
        { "id": "gain.pb09", "no": 3, "item": "速度控制增益 PB09 為振動發生值的 70–80%" },
        { "id": "gain.pb10", "no": 4, "item": "速度積分補償 PB10 為不振動範圍內的最小值" },
        { "id": "gain.pb08", "no": 5, "item": "位置控制增益 PB08 為不振動範圍內的最大值" },
        { "id": "gain.pb07", "no": 6, "item": "模型控制增益 PB07 為定位過衝量 ≤ 到位範圍 PA10 × 過衝容許位準 PA25 的最大值" }
      ]
    },
    {
      "id": "resonance",
      "name": "共振抑制",
      "scope": "axis",
      "pair": "gain",
      "criteria": [
        { "id": "res.adaptive", "no": 7, "item": "有片各段在自適應濾波器範圍內沒有波峰" },
        { "id": "res.notch", "no": 8, "item": "有片各段沒有波峰" }
      ]
    },
    {
      "id": "suppression",
      "name": "制振控制",
      "scope": "axis",
      "criteria": [
        { "id": "sup.tune", "no": 9, "item": "制振頻率在模型控制增益 PB07 允許範圍內" },
        { "id": "sup.stop", "no": 10, "item": "有片停止後滯留脈衝沒有波峰" }
      ]
    },
    {
      "id": "notch",
      "name": "指令陷波",
      "scope": "axis",
      "criteria": [
        { "id": "notch.cmd", "no": 11, "item": "有片各段運轉與停止的滯留脈衝沒有波峰" }
      ]
    }
  ]
}
