# Python 執行期產物
__pycache__/
*.py[cod]

# 虛擬環境（由 uv.lock 與 pyproject.toml 重建）
.venv/
.venv313/

# 建置產物（由 WR503-GPST-Monitor.spec 重建）
build/
build313/
dist/

# 開發文件與現場資料（只留本機）
docs/

# 調機資料：各軸的 MR Configurator2 工程、實驗紀錄、參數與採樣檔（只留本機）
data/

# /tune 目前選擇的機型、軸、階段與任務（每台工程機各自的狀態）
mods/tune/.tune/

# MR Configurator2 開啟專案時產生的鎖定檔
*.dup
_dup

# Office 開啟檔案時產生的暫存檔
~$*

# 執行期狀態資料庫
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
